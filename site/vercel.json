{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "has": [{ "type": "cookie", "key": "halyard-lang", "value": "pt" }], "destination": "/pt/", "permanent": false },
    { "source": "/", "has": [{ "type": "cookie", "key": "halyard-lang", "value": "es" }], "destination": "/es/", "permanent": false },
    { "source": "/", "has": [{ "type": "cookie", "key": "halyard-lang", "value": "en" }], "destination": "/en/", "permanent": false },
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*pt.*" }], "destination": "/pt/", "permanent": false },
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*es.*" }], "destination": "/es/", "permanent": false },
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*en.*" }], "destination": "/en/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept-Language, Cookie" }]
    }
  ]
}
