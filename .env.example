# Copy this file to ".env" and fill in your Supabase project (Project Settings > API Keys).
# Use ONLY the publishable key (starts with sb_publishable_). NEVER the secret key (sb_secret_)
# or the old service_role key: they bypass the database security and would ship inside the .exe.
MAIN_VITE_SUPABASE_URL=https://your-project-ref.supabase.co
MAIN_VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
